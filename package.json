{
  "name": "meimo",
  "version": "2.0.0",
  "description": "Meimo — Catatan Pribadi (Web PWA + Capacitor Native)",
  "main": "index.html",
  "scripts": {
    "prepare:www": "bash scripts/prepare-www.sh",
    "build": "npm run prepare:www",
    "cap:add": "npm run prepare:www && npx cap add android",
    "cap:sync": "npm run prepare:www && npx cap sync android && bash android-patches/patch-android.sh",
    "cap:open": "npx cap open android",
    "cap:run": "npm run prepare:www && npx cap run android",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:release": "cd android && ./gradlew assembleRelease",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "assets": "capacitor-assets generate --android --assetPath resources --iconBackgroundColor '#1E1E1E' --iconBackgroundColorDark '#1E1E1E' --splashBackgroundColor '#1E1E1E' --splashBackgroundColorDark '#1E1E1E'"
  },
  "keywords": ["notes", "capacitor", "pwa", "offline", "meimo"],
  "author": "Meimo",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@capacitor/share": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@capacitor/assets": "^3.0.5"
  }
}
